# Copy the values you need into your shell (export VAR=...) or into a local .env you source
# yourself - this project reads configuration from the environment, not from a .env loader.
# Nothing here is a real secret; do not commit real keys.

# --- TrueForge ---
TRUEFORGE_URL=http://localhost:8790
# TRUEFORGE_TOKEN=              # only if TrueForge login (OIDC) is enabled

# --- Model provider (pick ONE) ---
# Direct OpenAI (also accepted from the git-ignored file .sentinel/openai-api-key):
OPENAI_API_KEY=sk-...
SENTINEL_OPENAI_MODEL=gpt-4.1

# TrueFoundry AI gateway, as an alternative to OPENAI_API_KEY:
# TRUEFOUNDRY_GATEWAY_URL=
# TRUEFOUNDRY_API_KEY=
# SENTINEL_GATEWAY_MODEL_ID=

# Explicit override if more than one model provider ends up registered in TrueForge:
# SENTINEL_MODEL=openai/gpt-4-1

# --- Optional ---
# DAYTONA_API_KEY=              # isolated code sandbox; falls back to a local (non-isolated) one
SENTINEL_KUBE_CONTEXT=kind-sentinel-demo
SENTINEL_APPROVAL_MODE=auto     # auto = terminal prompt if there is a TTY else UI; ui = always UI
SENTINEL_DENY_COOLDOWN_MINUTES=30
